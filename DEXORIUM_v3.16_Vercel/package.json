{
  "name": "dexorium",
  "private": true,
  "version": "3.16.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/server.js\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "vite": "^5.4.10"
  }
}
